[sub_resource type="Resource" id="Ability_train_pionir"]
script = ExtResource("3_spawn")
unit = &"pionir"
id = &"train_pionir"
label = "Pionier ausbilden"
description = "Bildet einen einzelnen Pionier aus."
costs = {
&"wood": 25
}
duration = 5.0

[sub_resource type="Resource" id="Ability_set_rally_point"]
script = ExtResource("7a_rally")
id = &"set_rally_point"
label = "Sammelpunkt setzen"
description = "Rechtsklick auf die Karte legt fest, wo neue Einheiten erscheinen."

[sub_resource type="Resource" id="Requirement_house"]
script = ExtResource("1_req")
id = &"house"

[sub_resource type="Resource" id="Requirement_not_zentrale_2"]
script = ExtResource("1_req")
kind = 2
id = &"zentrale_2"
negated = true

[sub_resource type="Resource" id="Ability_upgrade_zentrale_2"]
script = ExtResource("4_upgrade_ability")
upgrade = &"zentrale_2"
id = &"upgrade_zentrale_2"
label = "Zentrale ausbauen"
description = "Baut die Zentrale zur Stufe 2 aus."
costs = {
&"stone": 100,
&"wood": 150
}
requirements = Array[ExtResource("1_req")]([SubResource("Requirement_house"), SubResource("Requirement_not_zentrale_2")])

[sub_resource type="Resource" id="Requirement_zentrale_2"]
script = ExtResource("1_req")
kind = 2
id = &"zentrale_2"

[sub_resource type="Resource" id="Ability_train_pionir_squad"]
script = ExtResource("3_spawn")
unit = &"pionir"
count = 3
id = &"train_pionir_squad"
label = "Pionier-Gruppe ausbilden"
description = "Bildet drei Pioniere gleichzeitig aus."
costs = {
&"stone": 10,
&"wood": 60
}
duration = 5.0
requirements = Array[ExtResource("1_req")]([SubResource("Requirement_zentrale_2")])

[sub_resource type="Resource" id="Building_zentrale"]
script = ExtResource("8_building_def")
id = &"zentrale"
label = "Zentrale"
scene = ExtResource("15_zentrale")
description = "Hauptgebäude. Bildet Pioniere aus, nimmt Ressourcen an und kann ausgebaut werden."
costs = {
&"stone": 100,
&"wood": 200
}
abilities = Array[ExtResource("2_ability")]([SubResource("Ability_train_pionir"), SubResource("Ability_set_rally_point"), SubResource("Ability_upgrade_zentrale_2"), SubResource("Ability_train_pionir_squad")])

[sub_resource type="Resource" id="Building_house"]
script = ExtResource("8_building_def")
id = &"house"
label = "Haus"
scene = ExtResource("10_house")
description = "Wohnhaus. Schaltet die Kaserne frei."
costs = {
&"wood": 50
}

[sub_resource type="Resource" id="Building_kaserne"]
script = ExtResource("8_building_def")
id = &"kaserne"
label = "Kaserne"
scene = ExtResource("11_kaserne")
description = "Benötigt ein Haus."
costs = {
&"stone": 40,
&"wood": 120
}
requires = Array[StringName]([&"house"])

[sub_resource type="Resource" id="Building_mil"]
script = ExtResource("8_building_def")
id = &"mil"
label = "Mühle"
scene = ExtResource("12_mil")
description = "Benötigt ein Haus und eine Kaserne."
costs = {
&"stone": 30,
&"wood": 100
}
requires = Array[StringName]([&"house", &"kaserne"])

[sub_resource type="Resource" id="Building_store"]
script = ExtResource("8_building_def")
id = &"store"
label = "Store"
scene = ExtResource("13_store")
description = "Lagerhaus. Benötigt ein Haus."
costs = {
&"wood": 80
}
requires = Array[StringName]([&"house"])

[sub_resource type="Resource" id="Building_tower"]
script = ExtResource("8_building_def")
id = &"tower"
label = "Tower"
scene = ExtResource("14_tower")
description = "Turm. Beschiesst gegnerische Einheiten mit Projektilen."
costs = {
&"stone": 120,
&"wood": 150
}
requires = Array[StringName]([&"kaserne"])

[sub_resource type="Resource" id="Unit_pionir"]
script = ExtResource("5_unit")
id = &"pionir"
label = "Pionier"
scene = ExtResource("9_agent")
description = "Sammelt Holz und Stein und kann Gebäude errichten."

[sub_resource type="Resource" id="Upgrade_zentrale_2"]
script = ExtResource("6_upgrade_def")
id = &"zentrale_2"
label = "Zentrale Stufe 2"
description = "Schaltet die Ausbildung von Pionier-Gruppen frei."

[resource]
script = ExtResource("7_catalog")
units = Array[ExtResource("5_unit")]([SubResource("Unit_pionir")])
upgrades = Array[ExtResource("6_upgrade_def")]([SubResource("Upgrade_zentrale_2")])
buildings = Array[ExtResource("8_building_def")]([SubResource("Building_zentrale"), SubResource("Building_house"), SubResource("Building_kaserne"), SubResource("Building_mil"), SubResource("Building_store"), SubResource("Building_tower")])

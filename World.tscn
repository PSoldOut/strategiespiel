[gd_scene format=3 uid="uid://duy662vx7mqeq"]

[sub_resource type="GDScript" id="GDScript_eu7l1"]
resource_name = "World"
script/source = "extends Node3D

var obstacle = preload(\"res://Obstacle.tscn\")
var AgentScene = preload(\"res://Agent.tscn\")
var preview_obj = null
var state = \"place\"



@onready var camera = $Camera3D
@onready var navRegion = $NavigationRegion3D
# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	navRegion.bake_navigation_mesh()
	
	preview_obj = obstacle.instantiate()
	add_child(preview_obj)

	# Transparent machen
	set_transparent(preview_obj)
	
	for i in range(1000):  
		var file = get_node(\"Agents\")
		var agent = AgentScene.instantiate()
		agent.position = Vector3( randf_range(-50.0, 50.0), 1,  randf_range(-50.0, 50.0))
		file.add_child(agent)
		
	
	pass # Replace with function body.


func set_transparent(obj):
	for child in obj.get_children():
		if child is MeshInstance3D:
			
			var mat = child.get_active_material(0)
			
			# Falls kein Material vorhanden → neues erstellen
			if mat == null:
				mat = StandardMaterial3D.new()
			
			# WICHTIG: duplizieren!
			mat = mat.duplicate()
			
			# Transparenz aktivieren
			mat.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA
			mat.albedo_color = Color(1, 1, 1, 0.3)
			
			# Optional: weniger Glanz / besser sichtbar
			mat.metallic = 0
			mat.roughness = 1
			
			child.set_surface_override_material(0, mat)



func _input(event):
	if event is InputEventMouseButton and event.pressed and state == \"place\":
		if event.button_index == MOUSE_BUTTON_LEFT:

			var obj = obstacle.instantiate()
			obj.global_position = preview_obj.global_position
			
			navRegion.add_child(obj)
			navRegion.bake_navigation_mesh()
	
	
				










func _process(delta):
	
	if state == \"place\":
		var camera = get_viewport().get_camera_3d()
		var mouse_pos = get_viewport().get_mouse_position()

		var from = camera.project_ray_origin(mouse_pos)
		var to = from + camera.project_ray_normal(mouse_pos) * 10000

		var space_state = get_world_3d().direct_space_state
		var query = PhysicsRayQueryParameters3D.create(from, to)
		var result = space_state.intersect_ray(query)

		if result:
			var pos = result.position
			
			var grid_size = 2.0
			pos = pos.snapped(Vector3(grid_size, 0, grid_size))
			
			pos.y = 2
			preview_obj.global_position = pos


func _on_button_pressed() -> void:
	state = \"place\"
	print(state)
	pass # Replace with function body.


func _on_button_2_pressed() -> void:
	state = \"choose\"
	print(state)
	pass # Replace with function body.
"


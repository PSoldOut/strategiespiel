[sub_resource type="GDScript" id="GDScript_eu7l1"]
resource_name = "World"
script/source = "extends Node3D

var obstacle = preload(\"res://Obstacle.tscn\")
var AgentScene = preload(\"res://Agent.tscn\")
var preview_obj = null


enum states {
	BUILD,
	SELECT
}

var state = states.SELECT

@onready var camera = $Camera3D
@onready var navRegion = $NavigationRegion3D
# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	navRegion.bake_navigation_mesh()
	
	var arr : Array = []
	for i in range(200):  
		var file = get_node(\"Agents\")
		var agent = AgentScene.instantiate()
		agent.position = Vector3( randf_range(0, 256), 1,  randf_range(0, 256))
		file.add_child(agent)
		arr.append(agent)
	$DragSelection.register_units(arr)
	#get_tree().get_nodes_in_group(\"units\")
	
	navRegion.bake_navigation_mesh()
	pass # Replace with function body.



	
	
			
	


func _on_drag_selection_move_command(positions: Array) -> void:
	for i in range($DragSelection.current_selected.size()):
		var unit = $DragSelection.current_selected[i]
		if is_instance_valid(unit):
			unit.get_unit().navigation_agent_3d.set_target_position(positions[i])
			unit.get_unit().state = unit.get_unit().State.MOVE_STRAIGHT


func _on_drag_selection_interact_command(target: SelectionUnit) -> void:
	for i in range($DragSelection.current_selected.size()):
		var unit = $DragSelection.current_selected[i]
		if is_instance_valid(unit):
			unit.get_unit().target = target.get_unit()
			unit.get_unit().state = unit.get_unit().State.CHASE
		



	


func _on_ui_button_selection_pressed() -> void:
	$RTSBuildSystem.unset_preview_object()
	$RTSBuildSystem.active = false
	$DragSelection.active = true
	state = states.SELECT


func _on_ui_button_house_pressed() -> void:
	$DragSelection.active = false
	$RTSBuildSystem.active = true
	$RTSBuildSystem.set_preview_object(preload(\"res://house.tscn\"))
	state = states.BUILD

func _on_ui_button_kaserne_pressed() -> void:
	$DragSelection.active = false
	$RTSBuildSystem.active = true
	$RTSBuildSystem.set_preview_object(preload(\"res://kaserne.tscn\"))
	state = states.BUILD

func _on_ui_button_mil_pressed() -> void:
	$DragSelection.active = false
	$RTSBuildSystem.active = true
	$RTSBuildSystem.set_preview_object(preload(\"res://mil.tscn\"))
	state = states.BUILD




func _on_ui_mouse_entered_panel() -> void:
	print(\"entered\")
	$RTSBuildSystem.active = false


func _on_ui_mouse_exited_panel() -> void:
	print(\"exited\")
	if state == states.BUILD:
		$RTSBuildSystem.active = true


func _on_rts_build_system_building_set_command(position: Vector3, scene: Variant) -> void:
	var obj = scene.instantiate()
	obj.global_position = position
	$NavigationRegion3D/Buildings.add_child(obj)
	$DragSelection.register_unit(obj)
	navRegion.bake_navigation_mesh()
	state = states.SELECT
	$RTSBuildSystem.active = false
	$DragSelection.active = true
"


[sub_resource type="GDScript" id="GDScript_eu7l1"]
resource_name = "World"
script/source = "extends Node3D

var obstacle = preload(\"res://Obstacle.tscn\")
var AgentScene = preload(\"res://Agent.tscn\")
@onready var camera = $Camera3D
@onready var navRegion = $NavigationRegion3D
# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	navRegion.bake_navigation_mesh()
	for i in range(1000):  
		var file = get_node(\"Agents\")
		var agent = AgentScene.instantiate()
		agent.position = Vector3( randf_range(-50.0, 50.0), 0,  randf_range(-50.0, 50.0))
		file.add_child(agent)
		
	
	pass # Replace with function body.





func _input(event):
	if event is InputEventMouseButton and event.pressed:
		if event.button_index == MOUSE_BUTTON_LEFT:

			var camera = get_viewport().get_camera_3d()
			var mouse_pos = event.position

			var from = camera.project_ray_origin(mouse_pos)
			var to = from + camera.project_ray_normal(mouse_pos) * 10000

			var space_state = get_world_3d().direct_space_state

			var query = PhysicsRayQueryParameters3D.create(from, to)
			var result = space_state.intersect_ray(query)
			
			if result:
				print(\"HIT:\", result.position)
				var obj = obstacle.instantiate()
				var pos = result.position
				
				
				var grid_size = 4.0
				pos = pos.snapped(Vector3(grid_size, 0, grid_size))
				
				pos.y = 2
				obj.global_position = pos
				navRegion.add_child(obj)
				navRegion.bake_navigation_mesh()
				


# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(delta: float) -> void:
	#print(Engine.get_frames_per_second())
	pass
"


[sub_resource type="GDScript" id="GDScript_eu7l1"]
resource_name = "World"
script/source = "extends Node3D

var obstacle = preload(\"res://Obstacle.tscn\")
var AgentScene = preload(\"res://Agent.tscn\")
var preview_obj = null
var state = \"place\"



@onready var camera = $Camera3D
@onready var navRegion = $NavigationRegion3D
# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	navRegion.bake_navigation_mesh()
	
	var arr : Array = []
	for i in range(500):  
		var file = get_node(\"Agents\")
		var agent = AgentScene.instantiate()
		agent.position = Vector3( randf_range(-50.0, 50.0), 1,  randf_range(-50.0, 50.0))
		file.add_child(agent)
		arr.append(agent)
		
	$DragSelection.set_units(arr)
	#get_tree().get_nodes_in_group(\"units\")
	pass # Replace with function body.



	
	
				
"


[sub_resource type="GDScript" id="GDScript_cmany"]
script/source = "extends Control

var is_selecting = false
var select_start = Vector2.ZERO
var select_end = Vector2.ZERO
@onready var camera : Camera3D = $\"../Camera3D\"

func _process(delta):
	if is_selecting:
		queue_redraw()

func _draw():
	if is_selecting:
		var rect = Rect2(select_start, select_end - select_start).abs()
		
		draw_rect(rect, Color(0, 1, 0, 0.2), true)
		draw_rect(rect, Color(0, 1, 0, 1), false)
		
		
		
func _input(event):
	if event is InputEventMouseButton:
		if event.button_index == MOUSE_BUTTON_LEFT:
			
			if event.pressed:
				is_selecting = true
				select_start = event.position
				select_end = event.position
			else:
				is_selecting = false
				queue_redraw()
				select_units()
		elif event.button_index == MOUSE_BUTTON_RIGHT:
			var pos = camera.project_position(event.position, 10000)
			#pos.y = 0
			print(pos)
			for unit in get_tree().get_nodes_in_group(\"units\"):
				if unit.selected:
					unit.navigation_agent_3d.set_target_position(pos)
			draw_circle(Vector2(event.position), 5, Color(0, 1, 0, 0.2), true)
	elif event is InputEventMouseMotion and is_selecting:
		select_end = event.position
		select_units()
		
		
		
		
		
		
		
	
func select_units():
	var rect = Rect2(select_start, select_end - select_start).abs()
	var camera = get_viewport().get_camera_3d()

	for unit in get_tree().get_nodes_in_group(\"units\"):
		var screen_pos = camera.unproject_position(unit.global_transform.origin)
		
		if rect.has_point(screen_pos):
			print(\"select()\")
			unit.select()
		else:
			unit.deselect()
"


[gd_scene format=3 uid="uid://0t1n5qpxrjno"]

[sub_resource type="GDScript" id="GDScript_kf3jx"]
resource_name = "spawner_unit_simple"
script/source = "extends Node3D

@export var unit_scene: PackedScene
@export var spawn_points: Array[Node3D]

func spawn_unit(team_id: int, point_index: int) -> Node:
	if unit_scene == null:
		push_error(\"unit_scene missing!\")
		return null
	if point_index < 0 or point_index >= spawn_points.size():
		push_error(\"invalid spawn point index\")
		return null
		
	var unit := unit_scene.instantiate()
	unit.global_position = spawn_points[point_index].global_position
	unit.team_id = team_id
	add_child(unit)
	return unit
	
"

[sub_resource type="StandardMaterial3D" id="StandardMaterial3D_kf3jx"]

[sub_resource type="GDScript" id="GDScript_wusub"]
script/source = "extends Control

signal button_house_pressed
signal button_kaserne_pressed
signal button_mil_pressed
signal button_selection_pressed
signal mouse_entered_panel
signal mouse_exited_panel

@export var subviewport : SubViewport

# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	pass # Replace with function body.


# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(delta: float) -> void:
	$Panel/MinimapContainer/VBoxContainer/Minimap.texture = subviewport.get_texture()


func activate_units_container(types : Array, counts : Array):
	$Panel/UnitsContainer/VBoxContainer/Label.text = str(counts[0]) +\"x \" + types[0]
	$Panel/UnitsContainer.visible = true
	
func deactivate_units_container():
	$Panel/UnitsContainer.visible = false
	
func activate_abilities_container(abilities : Array):
	$Panel/AbilitiesContainer.visible = true

func deactivate_abilities_container():
	$Panel/AbilitiesContainer.visible = false

func _on_button_build_pressed() -> void:
	$Panel/Build.visible = true


func _on_button_selection_pressed() -> void:
	button_selection_pressed.emit()


func _on_button_house_pressed() -> void:
	button_house_pressed.emit()

func _on_button_kaserne_pressed() -> void:
	button_kaserne_pressed.emit()

func _on_button_mil_pressed() -> void:
	button_mil_pressed.emit()


func _on_panel_mouse_entered() -> void:
	print(get_tree().root.gui_get_hovered_control())
	mouse_entered_panel.emit()


func _on_panel_mouse_exited() -> void:
	if not Rect2($Panel.position, $Panel.size).has_point(get_local_mouse_position()):
		mouse_exited_panel.emit()
"

